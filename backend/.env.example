# Copy this file to backend/.env and put in your own values. Never commit .env (it is in .gitignore).
# DB_PASSWORD is the password you chose when you ran scripts/create_app_user.sql.
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=mims_app
DB_PASSWORD=change-me
DB_NAME=mims
PORT=3001

# Optional: e-mail notifications (README, "Email notifications"). Leave SMTP_HOST empty to keep them off.
# For Gmail: SMTP_HOST=smtp.gmail.com, SMTP_PORT=465, SMTP_USER=the Gmail address, SMTP_PASS=its App password.
# Keep MAIL_DEMO_INBOX set: every e-mail then goes to that one address, never to the made-up sample customers.
SMTP_HOST=
SMTP_PORT=
SMTP_USER=
SMTP_PASS=
MAIL_FROM=
MAIL_DEMO_INBOX=
MAIL_REVIEW_TO=

{
  "name": "mims-backend",
  "version": "1.0.0",
  "private": true,
  "description": "Thin Express API for the MIMS database (B-Trust). It only calls stored procedures and runs read-only queries.",
  "type": "module",
  "main": "src/server.js",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "start": "node src/server.js",
    "dev": "node --watch src/server.js",
    "test": "node --test \"test/*.test.js\"",
    "test:db": "node --test \"test/integration/*.test.js\""
  },
  "dependencies": {
    "cors": "2.8.6",
    "dotenv": "18.0.5",
    "express": "5.2.1",
    "mysql2": "3.24.5"
  }
}

# Optional, for Docker only. Copy this file to .env (next to docker-compose.yml) and change the passwords before the
# first "docker compose up". Without a .env file, docker-compose.yml uses its local-only defaults. Never commit .env.
# The passwords are set when the database is first created; to change them later, run "docker compose down -v" first.
# Use letters, digits, - and _ only: the MySQL image cannot set a root password that contains a backslash.
MYSQL_ROOT_PASSWORD=choose-a-root-password
APP_DB_PASSWORD=choose-an-app-password

# Optional: signs the sign-in cookies (at least 16 characters). Empty = a new secret at every start, so everyone signs
# in again after a restart.
SESSION_SECRET=

# Optional: e-mail notifications (README, "Email notifications"). Leave SMTP_HOST empty to keep them off.
#   Test inbox, no account needed:  SMTP_HOST=mail  SMTP_PORT=1025  MAIL_DEMO_INBOX=demo@btrust.local
#                                    and start with: docker compose --profile mail up --build
#   Gmail:  SMTP_HOST=smtp.gmail.com  SMTP_PORT=465  SMTP_USER=the Gmail address  SMTP_PASS=its 16-letter App password
# MAIL_DEMO_INBOX sends EVERY e-mail to that one address. Keep it set: the sample customers' addresses are made up,
# but real people could own them. MAIL_REVIEW_TO gets an alert for each deposit flagged for review.
SMTP_HOST=
SMTP_PORT=
SMTP_USER=
SMTP_PASS=
MAIL_FROM=
MAIL_DEMO_INBOX=
MAIL_REVIEW_TO=

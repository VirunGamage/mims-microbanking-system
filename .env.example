# Optional, for Docker only. Copy this file to .env (next to docker-compose.yml) and change the passwords before the
# first "docker compose up". Without a .env file, docker-compose.yml uses its local-only defaults. Never commit .env.
# The passwords are set when the database is first created; to change them later, run "docker compose down -v" first.
# Use letters, digits, - and _ only: the MySQL image cannot set a root password that contains a backslash.
MYSQL_ROOT_PASSWORD=choose-a-root-password
APP_DB_PASSWORD=choose-an-app-password

# Settings for the cloud server (docs/DEPLOYMENT.md, step 6). On the server: cp cloud.env.example .env, then fill in
# every value with: nano .env   Never commit .env. Use letters, digits, - and _ in the passwords.

# The server's web address, for example btrust-mims.malaysiawest.cloudapp.azure.com. Caddy gets a free HTTPS
# certificate for it. Without a name, :80 serves plain http on the server's IP address (the login then travels
# unencrypted, so only use that for a quick test).
PUBLIC_ADDRESS=

# The login every visitor must type (password at least 8 characters). Share it only with the team and the examiners.
APP_USERNAME=examiner
APP_PASSWORD=

# Database passwords. They are set when the database is first created; to change them later, run
# docker compose -f docker-compose.yml -f docker-compose.cloud.yml down -v   (this also resets the data).
MYSQL_ROOT_PASSWORD=
APP_DB_PASSWORD=

# on  = the daily interest event runs on this server every day at 03:00 (Sri Lanka time) and posts savings and FD
#       interest by itself, like a real bank's overnight job. Only useful if the server runs day and night.
# off = interest is only posted with the Run interest button in the Tester view. Keep off while auto-shutdown is on.
MIMS_DAILY_INTEREST=off

# Optional: e-mail notifications, if the e-mail change is in the code (README, "Email notifications").
# Keep MAIL_DEMO_INBOX set so the made-up sample customers are never e-mailed.
SMTP_HOST=
SMTP_PORT=
SMTP_USER=
SMTP_PASS=
MAIL_FROM=
MAIL_DEMO_INBOX=
MAIL_REVIEW_TO=
